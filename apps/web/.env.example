# 굿잡 (GoodJob) 환경 변수 설정 템플릿
# 복사하여 .env.local 생성 후 실제 키를 입력하세요.

# 서비스 기본 URL (로컬: http://127.0.0.1:8080 / 배포: https://goodjob.vercel.app)
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Google Gemini API Key (3줄 요약 & AI 멘토 자동 생성용)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google OAuth 2.0 (Google Cloud Console -> API 및 서비스 -> 사용자 인증 정보)
# 승인된 리디렉션 URI: ${NEXT_PUBLIC_BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver OAuth 2.0 (네이버 개발자 센터 -> Application -> 내 애플리케이션)
# 서비스 URL: ${NEXT_PUBLIC_BASE_URL}
# Callback URL: ${NEXT_PUBLIC_BASE_URL}/api/auth/callback/naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 세션 암호화 비밀키
JWT_SECRET=goodjob_production_jwt_secret_key_2026
