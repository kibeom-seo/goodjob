# ==============================================================================
# 굿잡 (GoodJob) 상용 프로덕션 환경변수 템플릿 (.env.production.example)
# 실제 상용 배포 시 이 파일을 .env.production 으로 복사 후 비밀키를 주입하세요.
# 보안 주의: 실제 운영 키가 입력된 .env 파일은 Git 저장소에 커밋하지 마세요.
# ==============================================================================

# [기본 도메인 & 서비스 URL]
# 상용 도메인 (리디렉션, SEO 캐노니컬, OAuth 콜백 기본 베이스 URL)
NEXT_PUBLIC_BASE_URL=https://goodjob.kr
NEXT_PUBLIC_API_URL=https://goodjob.kr
NODE_ENV=production

# [보안 세션 & JWT 암호화]
# openssl rand -base64 32 등으로 생성한 256비트 이상의 강력한 비밀키
JWT_SECRET=goodjob_prod_jwt_secret_super_secure_key_change_me_2026

# [Google Gemini AI 엔진]
# Google AI Studio (https://aistudio.google.com) 에서 발급받은 API 키
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY_HERE

# [소셜 로그인 1: Google OAuth 2.0]
# Google Cloud Console (https://console.cloud.google.com) -> API 및 서비스 -> 사용자 인증 정보
# 승인된 리디렉션 URI: https://goodjob.kr/api/auth/callback/google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# [소셜 로그인 2: Naver OAuth 2.0]
# 네이버 개발자 센터 (https://developers.naver.com) -> Application -> 내 애플리케이션
# Callback URL: https://goodjob.kr/api/auth/callback/naver
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# [소셜 로그인 3: Kakao OAuth 2.0]
# 카카오 디벨로퍼스 (https://developers.kakao.com) -> 내 애플리케이션 -> 플랫폼 -> Web / 카카오 로그인
# Redirect URI: https://goodjob.kr/api/auth/callback/kakao
KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET

# [사내 보안 관제: Telegram Bot 긴급 경보]
# Telegram @BotFather 로부터 발급받은 봇 토큰 및 수신 대상 관리자 채팅방 ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
TELEGRAM_CHAT_ID=-1001234567890

# [채용절차법 3년 보관 준수: AWS S3 WORM 스토리지 원장]
# Object Lock (Compliance Mode)이 활성화된 불변 아카이브 버킷
AWS_S3_WORM_BUCKET=goodjob-production-legal-worm-archive
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=YOUR_AWS_IAM_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_IAM_SECRET_ACCESS_KEY
