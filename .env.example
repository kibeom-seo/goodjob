# ==========================================
# [환경변수 템플릿] JobConnect Platform
# ==========================================

# 1. Database & Cache
DATABASE_URL="postgresql://dev_user:dev_password@localhost:5432/job_platform?schema=public"
REDIS_URL="redis://localhost:6379"

# 2. Kafka Broker
KAFKA_BROKER="localhost:9092"

# 3. Google AI Studio (Gemini API)
# https://aistudio.google.com 에서 발급
GEMINI_API_KEY="your_gemini_api_key_here"

# 4. Anonymous Security Pepper (익명 게시판 단방향 암호화용)
ANON_GLOBAL_PEPPER="generate_a_very_long_random_secret_salt_here"

# 5. Social Auth (Kakao, Google, Naver)
KAKAO_CLIENT_ID="your_kakao_rest_api_key"
KAKAO_CLIENT_SECRET="your_kakao_client_secret"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

NAVER_CLIENT_ID="your_naver_client_id"
NAVER_CLIENT_SECRET="your_naver_client_secret"

# 6. JWT Secret
JWT_SECRET="your_jwt_secret_key_here"
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"
